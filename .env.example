# Keep the permanent key on the backend only.
# --- AI providers and the spend cap -------------------------------------------
# Keys live only here (untracked .env) and in the host's environment. Never commit real values.
ANTHROPIC_API_KEY=
# Model ids are configuration, not code. Grading = answer analysis; utility = hints, topics, phrase preparation.
ANTHROPIC_GRADING_MODEL=claude-sonnet-5-5
ANTHROPIC_UTILITY_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT_SECONDS=20
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_ASSISTANCE_TIMEOUT_SECONDS=6
ANTHROPIC_ASSISTANCE_MAX_RETRIES=0

ELEVENLABS_API_KEY=
# The Scribe speech-to-text model id from the ElevenLabs documentation. Left empty on purpose: confirm the current id.
ELEVENLABS_STT_MODEL=
ELEVENLABS_TIMEOUT_SECONDS=20
ELEVENLABS_MAX_RETRIES=1
TARGET_LANGUAGE_CODE=tr

# Hard cap on AI spend per UTC calendar month, across both providers. 0 stops every AI call.
AI_MONTHLY_BUDGET_USD=25
# Per-user share per UTC day, so one account cannot drain the budget. Admins are exempt.
AI_FREE_USER_DAILY_BUDGET_USD=0.5
AI_PREMIUM_USER_DAILY_BUDGET_USD=2.0
AI_BUDGET_ALERT_FRACTION=0.8
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_AUDIO_SECONDS=130
# USD prices used to measure spend. A model with no entry here is refused, so add every model id you configure.
# CHECK THESE AGAINST THE PROVIDERS' CURRENT PRICING PAGES BEFORE GOING LIVE. Add the ElevenLabs model id with
# its price per minute of audio, for example "your-stt-model-id":{"audio_per_minute":0.004}.
AI_PRICE_TABLE={"claude-sonnet-5-5":{"input_per_mtok":2,"output_per_mtok":10,"cache_write_per_mtok":2.5,"cache_read_per_mtok":0.1},"claude-haiku-5-5":{"input_per_mtok":0.1,"output_per_mtok":0.5,"cache_write_per_mtok":0.125,"cache_read_per_mtok":0.01}}

# --- Legacy OpenAI settings (adapters being removed; leave empty) -------------
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIBE_LANGUAGE_PARAMETER=language
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Admin experiment allowlist; model IDs and endpoint language contract stay in env.
OPENAI_TRANSCRIBE_MODELS=[{"model":"gpt-transcribe","language_parameter":"languages"},{"model":"gpt-4o-transcribe","language_parameter":"language"},{"model":"gpt-4o-mini-transcribe","language_parameter":"language"},{"model":"gpt-4o-mini-transcribe-2025-12-15","language_parameter":"language"},{"model":"whisper-1","language_parameter":"language"}]
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_ASSISTANCE_TIMEOUT_SECONDS=6
OPENAI_ASSISTANCE_MAX_RETRIES=0
MAX_AUDIO_BYTES=1000000

DATABASE_URL=sqlite:///./data/serbian_trainer.db
APP_ENV=development
CORS_ALLOWED_ORIGIN_REGEX=https://serbian-speaking-trainer(?:-[a-z0-9-]+)?\.vercel\.app
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated emails that get the admin role. Empty means nobody is an admin.
ADMIN_EMAILS=
FREE_DAILY_PHRASE_LIMIT=20
PREMIUM_DAILY_PHRASE_LIMIT=100
AUTH_TIMEOUT_SECONDS=5
AUTH_MAX_RETRIES=1
REVIEW_LOGIN_USERNAME=serbotalkreview
# Backend only: dedicated review account email, never a VITE variable.
REVIEW_LOGIN_EMAIL=

DEFAULT_LEVEL=A2
DEFAULT_SESSION_LENGTH=20
AUTO_NEXT=true

MASTERY_CONSOLIDATING_THRESHOLD=0.65
MASTERY_MASTERED_THRESHOLD=0.85
LONG_REACTION_MS=2500
LONG_INTERNAL_PAUSE_MS=1500

VAD_MODE=server_vad
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=700

# Optional backend-only activity notifications; never use VITE_ for these secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=3

# Backend-only manual Premium payment configuration. Empty config disables all methods.
# Setup and required fields: docs/manual-premium-payments-2026-10-26.md
MANUAL_PAYMENTS={}
# Optional override for only the SBP amount; all other payment details stay in MANUAL_PAYMENTS.
# MANUAL_PAYMENTS__METHODS__SBP__AMOUNT=500.00
