VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Enable only after configuring SMTP and OTP email templates in Supabase.
VITE_EMAIL_OTP_ENABLED=false

# Product identity (see src/shared/brand.ts). Public address used by "Share app"; when empty the web build
# uses its own origin and the Android build hides sharing. Support mailbox shown on the account-deletion page.
VITE_PUBLIC_APP_URL=
VITE_SUPPORT_EMAIL=
