{
  "name": "serbian-speaking-trainer-frontend",
  "private": true,
  "version": "1.45.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "android:sync": "pnpm build:android && cap sync android",
    "android:apk": "pnpm android:sync && cd android && gradlew.bat assembleProdDebug",
    "android:cloud-apk": "pnpm android:apk",
    "lint": "biome format . && eslint . && pnpm depcruise",
    "format": "biome format --write .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest",
    "test:e2e:mock": "playwright test e2e/mocked.spec.mjs e2e/settings-account.spec.mjs e2e/mobile-premium-cards.spec.mjs e2e/calendar-legend.spec.mjs e2e/custom-content.spec.mjs e2e/share-app.spec.mjs e2e/week-navigation.spec.mjs e2e/lazy-panels.spec.mjs e2e/manual-payments.spec.mjs e2e/network.spec.mjs e2e/localization-fixes.spec.mjs e2e/premium-tab.spec.mjs e2e/login-layout.spec.mjs e2e/startup.spec.mjs e2e/feedback-activity.spec.mjs e2e/review-access.spec.mjs e2e/source-language.spec.mjs e2e/context-hints.spec.mjs e2e/failure-diagnostics.spec.mjs e2e/premium-topic-cards.spec.mjs",
    "test:e2e:local": "playwright test local.spec.mjs",
    "test:e2e:android": "node e2e/android-testlab.mjs",
    "test:e2e:summary": "node e2e/summary.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "8.0.3",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.2.2",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "latest",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "dependency-cruiser": "^18.8.0",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
